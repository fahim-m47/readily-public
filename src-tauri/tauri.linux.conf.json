{
  "$schema": "https://schema.tauri.app/config/2",
  "build": {
    "beforeBuildCommand": "bash scripts/prepare-bundle.sh && bash scripts/opus-previews.sh"
  },
  "bundle": {
    "targets": ["deb", "rpm"],
    "createUpdaterArtifacts": false,
    "linux": {
      "deb": {
        "depends": ["libportaudio2", "gstreamer1.0-plugins-base", "gstreamer1.0-plugins-good"]
      },
      "rpm": {
        "depends": ["portaudio", "gstreamer1-plugins-base", "gstreamer1-plugins-good"]
      }
    }
  }
}
