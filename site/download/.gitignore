# Only the pages and the config are tracked. Everything else here is what
# scripts/publish-release.sh drops in to deploy from this Mac: the DMG and
# SHA256SUMS from dist-release/<version>/, and the repository's
# THIRD-PARTY-NOTICES renamed to .txt. Binaries have no business in the
# repository's history.
*
!.gitignore
!index.html
!download.html
!vercel.json
.vercel
.env*
